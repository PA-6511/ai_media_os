{
  "phase_id": "25-7",
  "phase_name": "Production Status GO/NO-GO Actual Measurement Integrated Final Judgment Report Design",
  "phase_japanese_name": "production_status GO/NO-GO 実測統合最終判定レポート設計",
  "purpose": "Design integrated final judgment report synthesizing all Phase 25-1 through 25-6 results",
  "layer": "production_status_actual_measurement_judgment_layer",
  "design_category": "reports_only",
  "_meta": {
    "operation_mode": "OBSERVE",
    "execution": "dry_run",
    "production_status": "NO_GO",
    "requires_human_approval": true,
    "auto_execute_allowed": false,
    "operation_transition_go_authorization": "NOT_GRANTED",
    "changed_area": "reports only"
  },
  "phase_25_7_scope": {
    "scope_1_input_contract": {
      "scope_id": "INPUT_CONTRACT",
      "required_inputs": {
        "phase25_1_to_25_3_status": "PASS_DESIGN_ONLY",
        "phase25_4_to_25_6_status": "PASS_DESIGN_ONLY",
        "phase25_3_judgment_template_status": "PASS_DESIGN_ONLY",
        "phase25_4_locking_rules_status": "PASS_DESIGN_ONLY",
        "phase25_5_rejection_rules_status": "PASS_DESIGN_ONLY",
        "phase25_6_abort_conditions_status": "PASS_DESIGN_ONLY"
      }
    },
    "scope_2_integrated_judgment_rules": {
      "scope_id": "INTEGRATED_JUDGMENT_RULES",
      "rules": {
        "rule_PIJ1": "Collect all Phase 25-3 judgment results",
        "rule_PIJ2": "Verify all Phase 25-4 evidence locks are LOCK_CONFIRMED",
        "rule_PIJ3": "Count unresolved_rejections from Phase 25-5; if > 0 then NO_GO",
        "rule_PIJ4": "Check Phase 25-6 abort conditions; if any TRIGGERED then ABORT",
        "rule_PIJ5": "If all checks PASS and no rejections, production_status = GO candidate",
        "rule_PIJ6": "If any check FAIL or rejections exist or ABORT triggered, production_status = NO_GO"
      }
    },
    "scope_3_report_structure": {
      "scope_id": "REPORT_STRUCTURE",
      "sections": {
        "section_1_header": {
          "report_id": "PHASE25_7_INTEGRATED_FINAL_JUDGMENT_<UTC_TIMESTAMP>",
          "report_type": "production_status_go_no_go_actual_measurement_integrated_final_judgment",
          "generated_at_utc": "RFC3339",
          "generated_by": "authority_identifier"
        },
        "section_2_phase25_3_judgment_summary": {
          "phase25_3_result_count": "integer",
          "phase25_3_minimum_condition_met": "PASS | FAIL"
        },
        "section_3_phase25_4_evidence_lock_summary": {
          "phase25_4_lock_count": "integer",
          "phase25_4_lock_confirmed_count": "integer",
          "phase25_4_evidence_integrity": "PASS | FAIL"
        },
        "section_4_phase25_5_rejection_summary": {
          "unresolved_rejections_count": "integer",
          "rejection_status": "CLEAN | UNRESOLVED"
        },
        "section_5_phase25_6_abort_summary": {
          "abort_condition_triggered": "TRIGGERED | NOT_TRIGGERED",
          "abort_reason_codes": [
            "PA1",
            "PA2",
            "PA3",
            "PA4",
            "PA5",
            "PA6",
            "PA7",
            "PA8"
          ]
        },
        "section_6_integrated_judgment": {
          "integrated_judgment": "GO_CANDIDATE | NO_GO",
          "production_status": "GO | NO_GO",
          "operation_transition_go_authorization": "GRANTED | NOT_GRANTED"
        }
      }
    }
  },
