        "feature": "post-approval prohibitions",
        "requirement": "承認後も 10個の banned actions を継続ブロック（dry_run only）",
        "actions_blocked": ["external_api_call", "wordpress_operation", "cron_registration", "auto_execute", "auto_post", "auto_update", "auto_delete", "auto_export", "production_execution", "core_ai_real_send"]
