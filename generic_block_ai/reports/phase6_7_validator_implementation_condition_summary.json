      {
        "feature": "decision types",
        "requirement": "APPROVE_DRY_RUN_ONLY / REQUEST_FIX / REJECT / ABORT を実装",
        "enforcement": "自動承認は禁止"
      },
      {
        "feature": "reviewer signature",
        "requirement": "reviewer_id + timestamp + signature の記録必須",
        "enforcement": "改ざん防止"
      },
      {
        "feature": "decision output",
        "requirement": "decision / reviewer_id / timestamp / comment / checklist_results / signature を出力"
