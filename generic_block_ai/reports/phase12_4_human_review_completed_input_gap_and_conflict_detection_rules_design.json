  "gap_and_conflict_rules": [
    {
      "rule_id": "GCR-01",
      "condition": "required receipt fields のいずれかが未記入",
      "classification": "GAP",
      "effect": "receipt_result cannot become PASS"
    },
    {
      "rule_id": "GCR-02",
      "condition": "reviewer.role が human_reviewer 以外",
      "classification": "CONFLICT",
      "effect": "consistency_confirmed = false"
    },
    {
      "rule_id": "GCR-03",
      "condition": "safety_boundary_verification の任意項目が false",
      "classification": "CONFLICT",
      "effect": "GO update forbidden"
    },
    {
      "rule_id": "GCR-04",
      "condition": "unresolved_items が空でない",
      "classification": "GAP",
      "effect": "receipt remains pending"
    },
    {
      "rule_id": "GCR-05",
      "condition": "Phase 11 測定結果と実記入内容の理由説明が矛盾する",
      "classification": "CONFLICT",
      "effect": "manual recheck required"
    }
