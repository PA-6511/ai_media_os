    "scope_2_locking_rules": {
      "scope_id": "LOCKING_RULES",
      "rules": {
        "rule_OTL1": "Canonicalize measured judgment payload before hashing",
        "rule_OTL2": "Compute SHA-256 hash and record as operation_transition_measured_judgment_hash",
        "rule_OTL3": "Sign hash with authority signature metadata",
        "rule_OTL4": "Append signed record to immutable append-only audit trail",
        "rule_OTL5": "Perform roundtrip hash/signature verification after append",
        "rule_OTL6": "If verification fails, lock_status = LOCK_FAILED and operation_transition_go_authorization = NOT_GRANTED"
      }
    },
