    "scope_2_locking_rules": {
      "scope_id": "LOCKING_RULES",
      "rules": {
        "rule_GL1": "Canonicalize full audit result payload before hash computation",
        "rule_GL2": "Compute SHA-256 hash and record as go_audit_result_hash",
        "rule_GL3": "Sign hash with authority signature metadata",
        "rule_GL4": "Append signed record to immutable append-only audit trail",
        "rule_GL5": "Run roundtrip verification for hash and signature after append",
        "rule_GL6": "Any verification failure sets lock_status = LOCK_FAILED and forces NO_GO maintenance"
      }
    },
    "scope_3_report_structure": {
      "scope_id": "REPORT_STRUCTURE",
      "sections": {
        "section_1_header": {
          "report_id": "PHASE22_4_GO_AUDIT_EVIDENCE_LOCK_<UTC_TIMESTAMP>",
