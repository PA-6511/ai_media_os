  "phase_23_6_scope": {
    "scope_1_abort_categories": {
      "scope_id": "ABORT_CATEGORIES",
      "categories": {
        "OA1": "Any operation-transition minimum condition is NOT_MET",
        "OA2": "Any evidence lock verification from Phase 23-4 is FAIL",
        "OA3": "Any unresolved rejection from Phase 23-5 exists",
        "OA4": "Any boundary separation violation is unresolved",
        "OA5": "Human final approval signature is invalid or inactive",
        "OA6": "Detected divergence between measured evidence and decision payload",
        "OA7": "Any unauthorized production execution trace is detected",
        "OA8": "Unclassified critical safety risk requiring mandatory halt"
      }
    },
    "scope_2_abort_handling_rules": {
      "scope_id": "ABORT_HANDLING_RULES",
      "rules": {
        "rule_OAH1": "If any OA1-OA8 is TRIGGERED, transition_status = ABORTED",
        "rule_OAH2": "Force operation_transition_go_authorization = NOT_GRANTED",
        "rule_OAH3": "Force production_status = NO_GO",
        "rule_OAH4": "Record abort_reason_codes and evidence-lock abort decision",
        "rule_OAH5": "Require human review clearance before re-entry"
      }
    },
    "scope_3_report_structure": {
