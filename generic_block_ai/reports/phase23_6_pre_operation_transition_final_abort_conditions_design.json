  "phase_japanese_name": "運用移行直前の最終ABORT条件設計",
  "purpose": "Design mandatory final ABORT conditions immediately before operation transition measurement application",
  "layer": "operation_transition_actual_measurement_reinforcement_layer",
  "design_category": "reports_only",
  "_meta": {
    "operation_mode": "OBSERVE",
    "execution": "dry_run",
