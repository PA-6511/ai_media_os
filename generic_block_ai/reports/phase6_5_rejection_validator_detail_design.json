{
  "_meta": {
    "phase": "6-5",
    "purpose": "rejection_validator_detail_design",
    "created_at": "2026-05-12",
    "status": "DESIGN_ONLY",
    "note": "Core側 rejection validator の詳細設計。拒否すべき条件を詳細化。WARN/REJECT/ABORT条件の明文化。実装候補は設計情報に留める。"
  },
  "validator_scope": {
    "validator_type": "rejection_validator",
    "purpose": "Core側から受け取る payload に対し、即座に拒否すべき条件を検証",
    "design_basis": [
      "reports/phase6_2_receiver_validator_implementation_conditions.json",
      "reports/phase5_2_core_rejection_conditions.json"
    ],
    "rejection_scope": [
      "operation_mode 逸脱",
      "execution 逸脱",
      "permission 逸脱",
      "transport 逸脱",
      "禁止 action 混入"
    ]
  },
  "operation_mode_violation_rejection": {
    "title": "operation_mode 違反拒否",
    "violation_types": [
      {
        "id": "mode_not_observe",
        "condition": "operation_mode != 'OBSERVE' である",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "OBSERVE mode は固定",
        "response": "rejection_code: MODE_VIOLATION"
      },
      {
        "id": "mode_undefined",
        "condition": "operation_mode フィールドが定義されていない",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "operation_mode は必須",
        "response": "rejection_code: MODE_UNDEFINED"
      },
      {
        "id": "mode_value_mismatch",
        "condition": "operation_mode が動的に変更される可能性",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "operation_mode は不変",
        "response": "rejection_code: MODE_MISMATCH"
      }
    ]
  },
  "execution_violation_rejection": {
    "title": "execution 違反拒否",
    "violation_types": [
      {
        "id": "execution_not_dry_run",
        "condition": "execution != 'dry_run' である",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "dry_run mode は固定",
        "response": "rejection_code: EXECUTION_VIOLATION"
      },
      {
        "id": "execution_undefined",
        "condition": "execution フィールドが定義されていない",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "execution は必須",
        "response": "rejection_code: EXECUTION_UNDEFINED"
      },
      {
        "id": "execution_production_mode",
        "condition": "execution が 'production' または similar 値",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT_ABORT",
        "reason": "本番実行は絶対禁止",
        "response": "rejection_code: PRODUCTION_MODE_DETECTED"
      }
    ]
  },
  "permission_violation_rejection": {
    "title": "permission 違反拒否",
    "violation_types": [
      {
        "id": "execution_permission_not_none",
        "condition": "execution_permission != 'none' である",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "execution_permission は none 固定",
        "response": "rejection_code: EXEC_PERMISSION_VIOLATION"
      },
      {
        "id": "write_permission_not_none",
        "condition": "write_permission != 'none' である",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "write_permission は none 固定",
        "response": "rejection_code: WRITE_PERMISSION_VIOLATION"
      },
      {
        "id": "transport_permission_invalid",
        "condition": "transport_permission not in ['none', 'internal_dry_run_reference']",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "transport_permission は限定値のみ",
        "response": "rejection_code: TRANSPORT_PERMISSION_VIOLATION"
      },
      {
        "id": "undefined_permission_field",
        "condition": "execution_permission / write_permission / transport_permission が undefined",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "permission field は必須",
        "response": "rejection_code: PERMISSION_UNDEFINED"
      }
    ]
  },
