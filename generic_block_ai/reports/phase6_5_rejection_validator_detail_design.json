  "safety_flags_violation_rejection": {
    "title": "safety flag 違反拒否",
    "violations": [
      {
        "id": "dry_run_false",
        "condition": "dry_run_mode = false",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "dry_run は必須",
        "response": "rejection_code: DRY_RUN_DISABLED"
      },
      {
        "id": "any_safety_flag_false",
        "condition": "external_call_blocked / wordpress_blocked / cron_blocked / auto_execute_blocked / production_execution_blocked のいずれか = false",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "safety flag は全て true 必須",
        "response": "rejection_code: SAFETY_FLAG_VIOLATION"
      },
      {
        "id": "safety_flag_undefined",
        "condition": "safety flag フィールドが定義されていない",
        "severity": "CRITICAL",
        "action": "IMMEDIATE_REJECT",
        "reason": "safety flag は必須",
        "response": "rejection_code: SAFETY_FLAG_UNDEFINED"
      }
    ]
  },
  "warn_conditions": {
    "title": "警告条件（human review 要求）",
    "warn_types": [
      {
        "id": "missing_audit_trail",
        "condition": "payload に audit trail 情報が不足",
        "severity": "WARNING",
        "action": "WARN",
        "requires_human_review": true,
        "reason": "トレーサビリティ確認必要"
      },
      {
        "id": "missing_reference_artifacts",
        "condition": "参照すべき artifact (phase5_1, phase5_2, phase5_3 等) が見つからない",
        "severity": "WARNING",
        "action": "WARN",
        "requires_human_review": true,
        "reason": "設計証跡の完全性確認必要"
      },
      {
        "id": "human_review_not_completed",
        "condition": "payload に human_review_completed flag がない、または false",
        "severity": "WARNING",
        "action": "WARN",
        "requires_human_review": true,
        "reason": "human review 完了確認必要"
      },
      {
        "id": "incomplete_safety_justification",
        "condition": "safety_boundary が定義されているが、その根拠が不足",
        "severity": "WARNING",
        "action": "WARN",
        "requires_human_review": true,
        "reason": "安全性根拠の詳細確認必要"
      },
      {
        "id": "unusual_decision_logic",
        "condition": "decision logic が通常と異なるパターン",
        "severity": "WARNING",
        "action": "WARN",
        "requires_human_review": true,
        "reason": "判定ロジックの適切性確認必要"
      }
    ]
  },
  "rejection_flow": {
    "step1_operation_mode_check": {
      "action": "operation_mode == 'OBSERVE' 確認",
      "violation": "IMMEDIATE_REJECT + rejection_code: MODE_VIOLATION",
      "pass": "step2へ進む"
    },
    "step2_execution_check": {
      "action": "execution == 'dry_run' 確認",
      "violation": "IMMEDIATE_REJECT + rejection_code: EXECUTION_VIOLATION",
      "pass": "step3へ進む"
    },
    "step3_permission_check": {
      "action": "execution_permission == 'none' AND write_permission == 'none' AND transport_permission in [none, internal_dry_run_reference] 確認",
      "violation": "IMMEDIATE_REJECT + rejection_code: PERMISSION_VIOLATION",
      "pass": "step4へ進む"
    },
    "step4_safety_flags_check": {
      "action": "全 safety_flags == true 確認",
      "violation": "IMMEDIATE_REJECT + rejection_code: SAFETY_FLAG_VIOLATION",
      "pass": "step5へ進む"
    },
    "step5_blocked_actions_scan": {
      "action": "禁止 action 10個が payload に混入していないか確認",
      "violation": "IMMEDIATE_REJECT + rejection_code: [ACTION]_BLOCKED",
      "pass": "step6へ進む"
    },
    "step6_warning_check": {
      "action": "WARN 条件をチェック",
      "warn": "WARN + human_review gate へ",
      "pass": "PASS（human_review validator へ進む）"
    }
  },
