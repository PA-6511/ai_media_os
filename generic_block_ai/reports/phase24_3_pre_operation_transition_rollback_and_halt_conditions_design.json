          "generated_at_utc": "RFC3339",
          "generated_by": "authority_identifier"
        },
        "section_2_condition_evaluation": {
          "RH1": "TRIGGERED | NOT_TRIGGERED",
          "RH2": "TRIGGERED | NOT_TRIGGERED",
          "RH3": "TRIGGERED | NOT_TRIGGERED",
          "RH4": "TRIGGERED | NOT_TRIGGERED",
          "RH5": "TRIGGERED | NOT_TRIGGERED",
          "RH6": "TRIGGERED | NOT_TRIGGERED"
