{
  "_meta": {
    "phase": "5-6",
    "purpose": "core_human_review_conditions_validator_template",
    "created_at": "2026-05-12",
    "status": "TEMPLATE_ONLY",
    "note": "Phase 5-3 human review 条件設計に対する validator 設計雛形。app 実装は行わない。"
  },
  "target": "reports/phase5_3_core_human_review_conditions.json",
  "runtime_constraints": {
    "operation_mode": "OBSERVE",
    "execution": "dry_run",
    "production_status": "NO_GO"
  },
  "required_review_conditions": [
    {"path": "review_requirements.requires_human_approval", "must_be": true},
    {"path": "review_requirements.auto_approval_allowed", "must_be": false},
    {"path": "review_requirements.review_state", "must_be": "HUMAN_REVIEW_REQUIRED"},
    {"path": "core_permissions.mode", "must_be": "observation_only"},
    {"path": "core_permissions.execution_permission", "must_be": "none"},
    {"path": "core_permissions.write_permission", "must_be": "none"}
  ],
  "required_pre_review_blocks": [
    "core_ai_real_send",
    "external_api_call",
    "wordpress_operation",
    "cron_registration",
    "auto_execute",
    "auto_post",
    "auto_update",
    "auto_delete",
    "auto_export",
    "production_execution"
  ],
  "required_post_review_still_blocked": [
    "external_api_call",
    "wordpress_operation",
    "cron_registration",
    "auto_execute",
    "auto_post",
    "auto_update",
    "auto_delete",
    "auto_export",
    "production_execution"
  ],
  "judgment_rule": {
    "pass_condition": "human review required and blocked actions preserved before/after review",
    "warn_condition": "review metadata partially incomplete while safety preserved",
    "fail_condition": "auto approval enabled or permissions not none/observation_only",
    "abort_condition": "production execution or external connection required"
  },
  "result": "PASS_DRY_RUN_ONLY"
}
