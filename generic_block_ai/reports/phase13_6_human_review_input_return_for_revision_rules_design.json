      "rule_id": "RFR-01",
      "condition": "reviewer.signature is empty",
      "classification": "SIGNATURE_MISSING",
      "effect": "return for revision"
    },
    {
      "rule_id": "RFR-02",
      "condition": "format_valid == false",
      "classification": "FORMAT_ERROR",
      "effect": "return for revision"
    },
    {
      "rule_id": "RFR-03",
      "condition": "all_checks_passed == false",
      "classification": "VALIDATION_FAILURE",
      "effect": "return for revision"
    },
    {
      "rule_id": "RFR-04",
      "condition": "conflicts_found == true",
      "classification": "CONFLICT_DETECTED",
      "effect": "manual recheck and return"
    },
    {
      "rule_id": "RFR-05",
      "condition": "forbidden_mutations detected or production_status changed",
      "classification": "SAFETY_VIOLATION",
      "effect": "abort acceptance and return"
    }
