      "audit_improvement_application",
      "publish_permission_change",
      "credential_scope_change",
      "freeze_rule_change"
    ]
  },
  "fixed_principles": [
    "Core AI is a manager/administrator, not a ruler/governor.",
    "Block AI autonomy should be preserved as much as possible inside approved boundaries.",
    "Core AI reviews whether Block AI behavior is too runaway or too suppressed.",
    "Audit Block AI observes Core AI balance and instability.",
    "Audit improvement reports require Human approval before application."
  ],
  "execution_guards": {
    "wordpress_write_allowed": false,
    "publish_allowed": false,
    "amazon_api_call_allowed": false,
    "x_api_call_allowed": false,
    "x_post_allowed": false,
    "approval_token_consumed": false
  }
