      "become_single_monolithic_executor",
      "treat_block_ai_as_only_subordinate_tool"
    ]
  },
  "block_ai_role": {
    "primary_role": "domain_autonomous_operator",
    "autonomy_principle": "Block AIs should operate as freely as possible within approved domain and safety boundaries.",
    "allowed_behaviors": [
      "domain_specific_candidate_selection",
      "domain_specific_validation",
      "draft_payload_preparation",
      "review_checklist_generation",
      "queue_preparation",
      "local_evidence_generation",
      "approved_scope_execution"
    ],
    "prohibited_behaviors": [
      "self_issue_approval_label",
      "change_core_boundary_without_approval",
      "ignore_freeze_state",
      "execute_unapproved_publish",
      "execute_unapproved_api_call",
      "skip_required_evidence"
    ]
  },
  "audit_block_ai_role": {
    "primary_role": "read_only_balance_observer",
    "purpose": "Observe whether Core AI becomes too strong, too weak, too rigid, too permissive, or too unstable.",
    "allowed_behaviors": [
      "observe_core_block_behavior",
      "score_balance",
      "generate_advisory_report",
      "propose_improvement",
      "escalate_to_human"
