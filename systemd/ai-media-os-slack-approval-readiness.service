[Unit]
Description=AI Media OS Slack Approval Readiness Worker
Documentation=file:/home/deploy/ai_media_os/reports/sql_b2_4b_5g_0_systemd_discovery_report.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/ai_media_os

EnvironmentFile=/etc/ai-media-os/slack.env
Environment=PYTHONPATH=/home/deploy/ai_media_os

ExecCondition=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/nonexistent LANG=C.UTF-8 /usr/bin/python3 -I /usr/local/libexec/ai-media-os/slack-autostart-verifier.py --check-autostart

ExecStartPre=/usr/bin/env DATABASE_BACKEND=sqlite DATABASE_URL=sqlite:////var/lib/ai-media-os-slack-readiness/ebook_affiliate_readiness.db SLACK_APPROVAL_MODE=DRY_RUN SLACK_APPROVAL_LIVE_CONFIRM= /home/deploy/ai_media_os/.venv/bin/python /home/deploy/ai_media_os/scripts/run_slack_approval_readiness.py --check-config
ExecStart=/usr/bin/env DATABASE_BACKEND=sqlite DATABASE_URL=sqlite:////var/lib/ai-media-os-slack-readiness/ebook_affiliate_readiness.db SLACK_APPROVAL_MODE=DRY_RUN SLACK_APPROVAL_LIVE_CONFIRM= /home/deploy/ai_media_os/.venv/bin/python /home/deploy/ai_media_os/scripts/run_slack_approval_readiness.py --start

Restart=on-failure
RestartSec=10s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM

StateDirectory=ai-media-os-slack-readiness
StateDirectoryMode=0700

UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/deploy/ai_media_os
ReadWritePaths=/var/lib/ai-media-os-slack-readiness

PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateNetwork=no

ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-media-os-slack-approval-readiness

[Install]
WantedBy=multi-user.target
