  "protocol_purpose": "公開実行時の手順・承認トークン・制約・証跡・停止条件を定義する。Phase 8-4 では公開を実行しない。",
  "protocol_steps": [
    {
      "id": "px_01",
      "step": "Phase 8-3 publish gate が PASS であることを確認",
      "mandatory": true
    },
    {
      "id": "px_02",
      "step": "Phase 8-2 decision が APPROVE であることを確認",
      "mandatory": true
    },
    {
      "id": "px_03",
      "step": "対象下書きIDとステータス(draft)を再確認",
      "mandatory": true
    },
    {
      "id": "px_04",
      "step": "公開承認トークンの一致と有効期限を確認",
      "mandatory": true
    },
    {
      "id": "px_05",
      "step": "人間オペレーターによる最終目視確認を実施",
      "mandatory": true
    },
    {
      "id": "px_06",
      "step": "1件限定公開であることを再確認",
      "mandatory": true
    },
    {
      "id": "px_07",
      "step": "公開失敗時の即時中止条件を確認",
      "mandatory": true
    },
    {
      "id": "px_08",
      "step": "公開後に証跡ログを保存する手順を確認",
      "mandatory": true
    },
    {
      "id": "px_09",
      "step": "再ロック手順を確認",
      "mandatory": true
    },
    {
      "id": "px_10",
      "step": "公開以外の操作（更新/削除/Export）が禁止であることを再確認",
      "mandatory": true
    }
  ],
  "approval_token_rules": {
    "token_name": "APPROVE_PUBLISH_ONE_TIME_MANUAL_ONLY",
    "token_value_required": "APPROVE_PUBLISH_ONE_TIME_MANUAL_ONLY",
    "one_time_only": true,
    "expires_minutes": 30,
    "human_reviewer_required": true,
    "publish_count_limit": 1,
    "allowed_status_transition": "draft_to_publish_only"
  },
  "safety_constraints": {
    "allow_publish_only": true,
    "allow_update": false,
    "allow_delete": false,
    "allow_export": false,
    "allow_bulk_operations": false,
    "allow_cron_automation": false
  },
  "abort_conditions": [
