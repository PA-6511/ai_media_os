    "status_not_draft",
    "token_missing_or_expired",
    "reviewer_not_human",
    "publish_response_not_2xx",
    "unexpected_multiple_publish_attempt",
    "safety_constraint_violation"
  ],
  "forbidden_actions_in_phase8_4": [
    "wordpress_rest_publish_post",
