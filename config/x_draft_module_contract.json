{
  "schema_version": "1.0.0",
  "phase_id": "X-R1",
  "contract_id": "X_DRAFT_MODULE_CONTRACT_V1",
  "module_id": "X_DRAFT_MODULE",
  "purpose": "Generate and validate an X post draft after a verified WordPress draft has been created, without posting to X or writing to WordPress.",
  "input_contract": {
    "required_fields": [
      "ebook_item_id",
      "title",
      "volume_label",
      "author_name",
      "article_url",
      "wordpress_draft_id",
      "wordpress_status"
    ],
    "field_rules": {
      "ebook_item_id": {
        "type": "string",
        "min_length": 1
      },
      "title": {
        "type": "string",
        "min_length": 1,
        "max_length": 500
      },
      "volume_label": {
        "type": "string",
        "min_length": 1,
        "max_length": 100
      },
      "author_name": {
        "type": "string",
        "min_length": 1,
        "max_length": 255
      },
      "article_url": {
        "type": "string",
        "required_scheme": "https",
        "placeholder_forbidden": true
      },
      "wordpress_draft_id": {
        "type": "integer",
        "minimum": 1
      },
      "wordpress_status": {
        "type": "string",
        "required_value": "DRAFT"
      }
    },
    "wordpress_success_sources": [
      {
        "id_field": "created_post_id",
        "status_field": "created_post_status",
        "required_status": "draft"
      },
      {
        "id_field": "new_post_id",
        "status_field": "returned_post_status",
        "required_status": "draft"
      }
    ]
  },
  "generation_contract": {
    "template_id": "X_DRAFT_NEW_RELEASE_SIMPLE_V1",
    "template_lines": [
      "配信開始です",
      "#PR #電子書籍",
      "『{title}』{volume_label}",
      "{author_hashtag}",
      "",
      "{article_url}"
    ],
    "include_synopsis": false,
    "include_price_comparison": false,
    "include_point_reward_comparison": false,
    "maximum_character_count": 280,
    "unicode_normalization": "NFKC",
    "line_endings": "LF",
    "trim_outer_whitespace": true
  },
  "output_contract": {
    "required_fields": [
      "feedback_id",
      "ebook_item_id",
      "wordpress_draft_id",
      "template_id",
      "generated_text",
      "character_count",
      "contains_pr",
      "selected_url",
      "record_stage",
      "x_status",
      "review_status"
    ],
    "fixed_values": {
      "record_stage": "DRAFT_GENERATED",
      "x_status": "DRAFT",
      "review_status": "IN_REVIEW"
    },
    "invariants": {
      "generated_text_required": true,
      "generated_text_must_be_under_character_limit": true,
      "pr_disclosure_required": true,
      "selected_url_must_equal_article_url": true,
      "selected_url_placeholder_forbidden": true,
      "feedback_record_initialization_required": true,
      "silent_overwrite_forbidden": true
    }
  },
  "workflow_mapping": {
    "database_x_status_before": [
      "NOT_CREATED",
      "ERROR"
    ],
    "database_x_status_after_generation": "DRAFT",
    "database_review_status_after_generation": "IN_REVIEW",
    "x_feedback_stage_after_generation": "DRAFT_GENERATED",
    "x_feedback_human_reviewed_stage": "HUMAN_REVIEWED",
    "database_review_status_after_human_approval": "APPROVED",
    "database_x_status_after_manual_post": "POSTED",
    "failure_x_status": "ERROR"
  },
  "storage_contract": {
    "feedback_current_record_pattern": "exchange/input/x_post_feedback/{feedback_id}/current.json",
    "feedback_archive_record_pattern": "exchange/archive/x_post_feedback/{feedback_id}/v{record_version:03d}.json",
    "operation_result_pattern": "exchange/logs/x_fb_1_{feedback_id}_v{record_version:03d}_result.json",
    "database_table_addition_required": false,
    "workflow_history_required": true
  },
  "failure_policy": {
    "fail_closed": true,
    "partial_state_update_forbidden": true,
    "x_status_on_generation_failure": "ERROR",
    "last_error_recording_required": true,
    "wordpress_draft_must_not_be_modified": true,
    "automatic_retry_allowed": false
  },
  "execution_boundary": {
    "local_json_read_allowed": true,
    "local_json_write_allowed": true,
    "sqlite_state_write_allowed_in_next_phase": true,
    "x_api_call_allowed": false,
    "x_post_allowed": false,
    "wordpress_write_allowed": false,
    "external_api_call_allowed": false,
    "automatic_human_approval_allowed": false,
    "automatic_posted_transition_allowed": false,
    "production_status": "NO_GO",
    "safety_state": "DRY_RUN_ONLY"
  },
  "next_phase": {
    "phase_id": "X-R2",
    "name": "X Draft Generation Service",
    "execution_allowed": false
  }
}
